<style>
  :root{
    --ink:#1B2430;
    --paper:#EDEEE9;
    --mint:#00D9A6;
    --petrol:#14746F;
    --text:#2B2E33;
    --text-soft:#5B6067;
    --line:#D6D8D2;
    --white:#FBFBF9;
    color-scheme:light;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--text);
    font-family:'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.wordmark{
    font-family:'Space Grotesk', 'Inter', sans-serif;
    letter-spacing:-0.01em;
    margin:0;
  }
  a{color:inherit;text-decoration:none;}
  .wrap{max-width:920px;margin:0 auto;padding:0 24px;}

  /* ---------- Header ---------- */
  header{
    background:var(--ink);
    color:var(--white);
    padding:20px 0;
  }
  header .wrap{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;}
  .wordmark{font-size:1.3rem;font-weight:600;color:var(--white);}
  .wordmark span{color:var(--mint);}
  .logo-img{height:28px;width:auto;display:block;}
  nav{display:flex;gap:28px;font-size:0.92rem;}
  nav a{color:#C9CCC6;transition:color .15s;}
  nav a:hover{color:var(--white);}

  /* ---------- Hero ---------- */
  .hero{
    background:var(--ink);
    color:var(--white);
    padding:64px 0 88px;
    position:relative;
    overflow:hidden;
  }
  .hero .wrap{position:relative;z-index:2;}
  .hero-net{
    position:absolute;
    top:0; right:-60px;
    width:520px; height:100%;
    opacity:0.5;
    z-index:1;
  }
  .hero h1{
    font-size:2.6rem;
    font-weight:600;
    max-width:600px;
    line-height:1.18;
  }
  .hero p{
    max-width:520px;
    color:#C9CCC6;
    font-size:1.05rem;
    margin-top:18px;
  }
  .hero .meta{
    margin-top:10px;
    color:var(--mint);
    font-size:0.95rem;
  }
  .cta-row{margin-top:34px;display:flex;gap:16px;flex-wrap:wrap;}
  .btn{
    display:inline-block;
    padding:13px 26px;
    font-size:0.95rem;
    font-weight:600;
    border-radius:3px;
    transition:transform .15s, background .15s;
  }
  .btn-primary{background:var(--mint);color:var(--ink);}
  .btn-primary:hover{background:#00B88C;}
  .btn-ghost{border:1px solid #4A525C;color:var(--white);}
  .btn-ghost:hover{border-color:var(--white);}

  /* ---------- Sections ---------- */
  section{padding:64px 0;}
  section + section{border-top:1px solid var(--line);}
  .section-head{margin-bottom:36px;max-width:540px;}
  .section-head h2{font-size:1.7rem;font-weight:600;}
  .section-head p{color:var(--text-soft);margin-top:10px;font-size:1rem;}

  /* ---------- Leistungen ---------- */
  .service{
    display:grid;
    grid-template-columns:200px 1fr;
    gap:28px;
    padding:26px 0;
    border-top:1px solid var(--line);
  }
  .service:first-of-type{border-top:none;}
  .service h3{font-size:1.05rem;font-weight:600;color:var(--ink);}
  .service .tag{
    display:inline-block;
    margin-top:8px;
    font-size:0.78rem;
    color:var(--petrol);
    border:1px solid var(--petrol);
    border-radius:2px;
    padding:2px 8px;
  }
  .service p{color:var(--text-soft);font-size:0.96rem;max-width:460px;}

  /* ---------- Preise ---------- */
  table{width:100%;border-collapse:collapse;font-size:0.94rem;}
  th,td{text-align:left;padding:12px 10px;border-bottom:1px solid var(--line);}
  th{color:var(--text-soft);font-weight:600;font-size:0.82rem;text-transform:none;}
  td.price{color:var(--petrol);font-weight:600;white-space:nowrap;}
  .price-note{margin-top:18px;color:var(--text-soft);font-size:0.88rem;}

  /* ---------- Ueber mich ---------- */
  .about{display:grid;grid-template-columns:1fr;gap:20px;}
  .about .badge{
    display:inline-block;
    background:var(--ink);
    color:var(--white);
    font-size:0.78rem;
    padding:4px 10px;
    border-radius:2px;
    margin-bottom:14px;
    margin-right:8px;
