    background:var(--ink);
    color:var(--white);
    border-radius:4px;
    padding:40px;
  }
  .contact-box h2{color:var(--white);font-size:1.5rem;}
  .contact-box p{color:#C9CCC6;margin-top:10px;max-width:480px;}
  .contact-list{margin-top:26px;display:flex;flex-direction:column;gap:10px;font-size:0.98rem;}
  .contact-list a{color:var(--mint);}
  .contact-list a:hover{text-decoration:underline;}

