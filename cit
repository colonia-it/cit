  footer .legal-links{display:flex;gap:16px;}
  footer .legal-links a{color:var(--text-soft);}
  footer .legal-links a:hover{color:var(--ink);}

  .legal{background:var(--white);}
  .legal .wrap{max-width:720px;}
  .legal h2{font-size:1.5rem;font-weight:600;margin-bottom:20px;}
  .legal h3{font-size:1rem;font-weight:600;margin-top:26px;margin-bottom:8px;color:var(--ink);}
  .legal p{color:var(--text-soft);font-size:0.94rem;line-height:1.6;margin-top:6px;}
  .legal a{color:var(--petrol);}
  .legal .top-link{display:inline-block;margin-top:28px;font-size:0.85rem;color:var(--petrol);}

  @media (max-width:640px){
    .hero h1{font-size:2rem;}
    .service{grid-template-columns:1fr;gap:8px;}
    .hero-net{display:none;}
    .contact-box{padding:28px;}
    nav{gap:16px;font-size:0.85rem;}
  }
